@model IEnumerable<impoTrack.Models.Informe>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TipoInforme)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaGeneracion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DatosInforme)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TipoInforme)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaGeneracion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DatosInforme)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.InformeID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.InformeID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.InformeID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
