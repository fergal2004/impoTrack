@model impoTrack.Models.Pedido

@{
    ViewData["Title"] = "Crear Nuevo Pedido";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <hr class="mb-4" />
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title mb-3">Ingrese los detalles del pedido</h5>
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="FechaPedido" class="form-label"><i class="bi bi-calendar-event me-2"></i> Fecha del Pedido:</label>
                            <input asp-for="FechaPedido" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaPedido" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EstadoPedido" class="form-label"><i class="bi bi-tag me-2"></i> Estado del Pedido:</label>
                            <input asp-for="EstadoPedido" class="form-control" />
                            <span asp-validation-for="EstadoPedido" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DireccionEntrega" class="form-label"><i class="bi bi-geo-alt me-2"></i> Dirección de Entrega:</label>
                            <input asp-for="DireccionEntrega" class="form-control" />
                            <span asp-validation-for="DireccionEntrega" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClienteNombre" class="form-label"><i class="bi bi-person me-2"></i> Nombre del Cliente:</label>
                            <input asp-for="ClienteNombre" class="form-control" />
                            <span asp-validation-for="ClienteNombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RepartidorID" class="form-label"><i class="bi bi-person-fill-gear me-2"></i> Repartidor:</label>
                            <div class="input-group">
                                <select asp-for="RepartidorID" class="form-control" id="repartidorSelect" asp-items="ViewBag.RepartidorID">
                                    <option value="">-- Seleccionar Repartidor --</option>
                                </select>
                                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#agregarRepartidorModal" title="Agregar Nuevo Repartidor">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="RepartidorID" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductoID" class="form-label"><i class="bi bi-box-seam me-2"></i> Producto:</label>
                            <select asp-for="ProductoID" class="form-control" asp-items="ViewBag.ProductoID">
                                <option value="">-- Seleccionar Producto --</option>
                            </select>
                            <span asp-validation-for="ProductoID" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaEntregaEstimada" class="form-label"><i class="bi bi-calendar-check me-2"></i> Fecha de Entrega Estimada:</label>
                            <input asp-for="FechaEntregaEstimada" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaEntregaEstimada" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle-fill me-2"></i> Crear Pedido</button>
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-short me-2"></i> Volver a la Lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="agregarRepartidorModal" tabindex="-1" aria-labelledby="agregarRepartidorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="agregarRepartidorModalLabel">Agregar Nuevo Repartidor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="agregarRepartidorForm">
                    <div class="mb-3">
                        <label for="nombreRepartidor" class="form-label">Nombre Completo:</label>
                        <input type="text" class="form-control" id="nombreRepartidor" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarRepartidorBtn">Guardar Repartidor</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $("#guardarRepartidorBtn").click(function () {
                var nombreRepartidor = $("#nombreRepartidor").val();

                if (nombreRepartidor) {
                    $.ajax({
                        url: '/Pedido/AgregarRepartidor', // Reemplaza con la URL correcta de tu acción
                        type: 'POST',
                        data: { nombreCompleto: nombreRepartidor }, // Ajusta los datos según las propiedades de tu modelo Repartidor
                        success: function (data) {
                            if (data.id && data.nombreCompleto) {
                                var newOption = new Option(data.nombreCompleto, data.id, true, true);
                                $('#repartidorSelect').append(newOption).trigger('change');
                                $('#agregarRepartidorModal').modal('hide');
                                $("#nombreRepartidor").val(''); // Limpiar el formulario
                            } else {
                                alert('Error al guardar el repartidor.');
                            }
                        },
                        error: function () {
                            alert('Error de conexión al servidor.');
                        }
                    });
                } else {
                    alert('Por favor, ingrese el nombre del repartidor.');
                }
            });
        });
    </script>
}