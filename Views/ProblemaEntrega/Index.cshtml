@model IEnumerable<impoTrack.Models.ProblemaEntrega>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Pedido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DescripcionProblema)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaReporte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoProblema)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Responsable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Solucion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Pedido.DireccionEntrega)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescripcionProblema)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaReporte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoProblema)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Responsable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Solucion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProblemaID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProblemaID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProblemaID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
