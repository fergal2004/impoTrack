@* Views/Home/Index.cshtml *@
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container mt-5">
    <h1 class="mb-4">Bienvenido a impoTrack</h1>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-plus-square text-primary mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Crear Nuevo Pedido</h5>
                    <p class="card-text">Registra un nuevo pedido en el sistema.</p>
                    <a asp-controller="Pedido" asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-file-earmark-plus-fill"></i> Crear Pedido
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus-fill text-info mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Agregar Repartidor</h5>
                    <p class="card-text">Registra un nuevo repartidor en el sistema.</p>
                    <a asp-controller="Repartidor" asp-action="Create" class="btn btn-info btn-sm">
                        <i class="bi bi-person-plus"></i> Agregar Repartidor
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list-task text-success mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Ver Todos los Pedidos</h5>
                    <p class="card-text">Visualiza y gestiona todos los pedidos del sistema.</p>
                    <a asp-controller="Pedido" asp-action="Index" class="btn btn-success btn-sm">
                        <i class="bi bi-eye-fill"></i> Ver Pedidos
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam-fill text-warning mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Gestionar Productos</h5>
                    <p class="card-text">Visualiza y gestiona los productos del sistema.</p>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-warning btn-sm">
                        <i class="bi bi-box-seam"></i> Gestionar Productos
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill text-warning mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Ver Repartidores</h5>
                    <p class="card-text">Visualiza y gestiona los repartidores del sistema.</p>
                    <a asp-controller="Repartidor" asp-action="Index" class="btn btn-warning btn-sm">
                        <i class="bi bi-eye"></i> Ver Repartidores
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-truck text-primary mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Gestionar Entregas</h5>
                    <p class="card-text">Asigna pedidos a repartidores y gestiona las entregas.</p>
                    <a asp-controller="Entrega" asp-action="Index" class="btn btn-primary btn-sm">
                        <i class="bi bi-list-check"></i> Gestionar Entregas
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Gestionar Problemas</h5>
                    <p class="card-text">Visualiza y resuelve los problemas reportados en las entregas.</p>
                    <a asp-controller="ProblemaEntrega" asp-action="Index" class="btn btn-danger btn-sm">
                        <i class="bi bi-wrench"></i> Gestionar Problemas
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-bar-graph text-info mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Generar Informes</h5>
                    <p class="card-text">Crea informes detallados sobre el rendimiento del sistema.</p>
                    <a asp-controller="Informe" asp-action="Index" class="btn btn-info btn-sm">
                        <i class="bi bi-bar-chart-line"></i> Generar Informes
                    </a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-door-closed-fill text-secondary mb-3" style="font-size: 2rem;"></i>
                    <h5 class="card-title">Cerrar Sesión</h5>
                    <p class="card-text">Finaliza tu sesión actual en el sistema.</p>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-secondary btn-sm">
                        <i class="bi bi-power"></i> Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}